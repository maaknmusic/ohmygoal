{
    "name": "Anonymous Connect",
    "short_name": "AnonConnect",
    "description": "Random video and text chat with people around the world.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "background_color": "#090a12",
    "theme_color": "#d9266c",
    "icons": [
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "id": "./",
    "orientation": "any",
    "lang": "en",
    "categories": [
        "social",
        "entertainment"
    ],
    "shortcuts": [
        {
            "name": "Start a video chat",
            "short_name": "Video",
            "url": "./?mode=video",
            "icons": [
                {
                    "src": "icons/icon-192.png",
                    "sizes": "192x192"
                }
            ]
        },
        {
            "name": "Start a text chat",
            "short_name": "Text",
            "url": "./?mode=text",
            "icons": [
                {
                    "src": "icons/icon-192.png",
                    "sizes": "192x192"
                }
            ]
        }
    ]
}
