rules_version = '2';

// Security rules for Anonymous Connect.
// Random-chat messages never touch the database (they go peer-to-peer over a data channel).
// Firestore holds short-lived matchmaking + WebRTC signaling data, presence, reports,
// friendships (+ friend messages) and Premium entitlements (written only by Cloud Functions).
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/public/data {

      function now() { return request.time.toMillis(); }
      function recentTs(ts) { return ts is int && ts <= now() + 60000 && ts >= now() - 600000; }
      function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function google() {
        return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
      }

      // ---------------- Premium ----------------
      // Passes are granted ONLY by the payment Cloud Functions (the Admin SDK bypasses rules).
      function isPremium(uid) {
        let path = /databases/$(database)/documents/artifacts/$(appId)/public/data/entitlements/$(uid);
        return exists(path) && get(path).data.premiumUntil > now();
      }

      // ---------------- Access passes ----------------
      // Written only by the checkAccess Cloud Function after checking IP / device / account bans.
      function hasAccess(uid, mode) {
        let path = /databases/$(database)/documents/artifacts/$(appId)/public/data/access/$(uid);
        return exists(path) && get(path).data.until > now()
          && (mode != 'video' || get(path).data.get('videoBanUntil', 0) < now());
      }

      match /access/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow list, write: if false;
      }

      match /entitlements/{uid} {
        allow get: if request.auth != null; // lets a partner verify a Premium badge
        allow list, write: if false;
      }

      // ---------------- Reputation ("good vibe" likes) ----------------
      // Written only by the likeUser Cloud Function. Readable one uid at a time (a partner's like
      // count), never listable, so nobody can enumerate or rank users.
      match /reputation/{uid} {
        allow get: if request.auth != null;
        allow list, write: if false;
      }

      // ---------------- Matchmaking queue ----------------
      function validQueue(d) {
        return d.keys().hasOnly(['mode', 'interests', 'blocked', 'gender', 'country', 'genderFilter',
                                 'countryFilter', 'premium', 'ts', 'roomId'])
          && d.mode in ['video', 'voice', 'text']
          && d.get('interests', []) is list && d.get('interests', []).size() <= 5
          && d.get('blocked', []) is list && d.get('blocked', []).size() <= 100
          && d.get('gender', 'x') in ['male', 'female', 'x']
          && d.get('country', '') is string && d.get('country', '').size() <= 2
          && d.get('genderFilter', 'any') in ['any', 'male', 'female']
          && d.get('countryFilter', 'any') is string && d.get('countryFilter', 'any').size() <= 3
          && d.get('premium', false) is bool
          && d.get('roomId', null) == null
          && recentTs(d.ts);
      }
      // Gender/country filters and priority matching are Premium features.
      function usesPremium(d) {
        return d.get('genderFilter', 'any') != 'any' || d.get('countryFilter', 'any') != 'any'
          || d.get('premium', false) == true;
      }
      // A claimer must be queued themselves, in the same mode, not blocked either way,
      // and must satisfy the target's filters.
      function claimAllowed(uid) {
        let mine = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/queue/$(request.auth.uid)).data;
        let theirs = resource.data;
        return mine.mode == theirs.mode
          && !(request.auth.uid in theirs.get('blocked', []))
          && !(uid in mine.get('blocked', []))
          && theirs.get('genderFilter', 'any') in ['any', mine.get('gender', 'x')]
          && theirs.get('countryFilter', 'any') in ['any', mine.get('country', '')];
      }

      match /queue/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid
          && validQueue(request.resource.data)
          && hasAccess(uid, request.resource.data.mode)
          && (!usesPremium(request.resource.data) || isPremium(uid));
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && (
          // owner heartbeat
          (request.auth.uid == uid && changes().hasOnly(['ts']) && recentTs(request.resource.data.ts))
          // owner re-queues over a stale entry
          || (request.auth.uid == uid && validQueue(request.resource.data)
              && hasAccess(uid, request.resource.data.mode)
              && (!usesPremium(request.resource.data) || isPremium(uid)))
          // someone else claims an unclaimed entry, creating a real room for the two of them
          || (request.auth.uid != uid
              && resource.data.get('roomId', null) == null
              && changes().hasOnly(['roomId', 'partnerId'])
              && request.resource.data.partnerId == request.auth.uid
              && request.resource.data.roomId is string
              && claimAllowed(uid)
              && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(request.resource.data.roomId)).data.users.hasAll([uid, request.auth.uid]))
        );
      }

      // ---------------- Rooms & signaling ----------------
      match /rooms/{roomId} {
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['mode', 'users', 'created', 'friendship'])
          && request.resource.data.mode in ['video', 'voice', 'text']
          && request.resource.data.users is list
          && request.resource.data.users.size() == 2
          && request.auth.uid in request.resource.data.users
          && hasAccess(request.auth.uid, request.resource.data.mode);
        allow read: if request.auth != null && request.auth.uid in resource.data.users;

        // Signaling messages: only the two room members can read/write, and only as themselves.
        match /signals/{signalId} {
          function isMember() {
            return request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(roomId)).data.users;
          }
          allow read: if request.auth != null && isMember();
          allow create: if request.auth != null && isMember()
            && request.resource.data.from == request.auth.uid;
          allow delete: if request.auth != null && resource.data.from == request.auth.uid;
        }
      }

      // ---------------- Presence ("people online") ----------------
      match /presence/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ts', 'status'])
          && recentTs(request.resource.data.ts);
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // ---------------- Friends ----------------
      // Doc id is "<uidA>_<uidB>" (sorted). Created "pending" by the requester, accepted by the
      // other person. Only Google-signed-in users can befriend.
      function validName(d, u) { return d.names.get(u, '') is string && d.names.get(u, '').size() <= 30; }
      function validCall(c) {
        return c == null || (c is map && c.keys().hasOnly(['from', 'roomId', 'ts'])
          && c.from is string && c.roomId is string && c.ts is int);
      }
      function validFriendship(d, pairId) {
        return d.keys().hasOnly(['users', 'status', 'requestedBy', 'names', 'createdAt', 'acceptedAt',
                                 'call', 'lastMessage', 'lastMessageAt'])
          && d.users is list && d.users.size() == 2 && d.users[0] is string && d.users[1] is string
          && pairId == d.users[0] + '_' + d.users[1]
          && d.status in ['pending', 'accepted']
          && d.requestedBy in d.users
          && d.names is map && d.names.keys().hasOnly(d.users)
          && validName(d, d.users[0]) && validName(d, d.users[1])
          && validCall(d.get('call', null))
          && d.get('lastMessage', '') is string && d.get('lastMessage', '').size() <= 80
          && d.get('lastMessageAt', 0) is int;
      }

      match /friendships/{pairId} {
        allow read: if request.auth != null && request.auth.uid in resource.data.users;
        allow create: if google()
          && validFriendship(request.resource.data, pairId)
          && request.auth.uid in request.resource.data.users
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if google() && request.auth.uid in resource.data.users
          && validFriendship(request.resource.data, pairId)
          && request.resource.data.users == resource.data.users && (
          // either person (re-)sends a request while it is still pending
          (resource.data.status == 'pending' && request.resource.data.status == 'pending'
            && request.resource.data.requestedBy == request.auth.uid)
          // the other person accepts, setting only their own name
          || (resource.data.status == 'pending' && request.auth.uid != resource.data.requestedBy
            && request.resource.data.status == 'accepted'
            && changes().hasOnly(['status', 'names', 'acceptedAt'])
            && request.resource.data.names.get(resource.data.requestedBy, '') == resource.data.names.get(resource.data.requestedBy, ''))
          // friends: ring / cancel a call (only as yourself), update the chat preview
          || (resource.data.status == 'accepted' && request.resource.data.status == 'accepted'
            && changes().hasOnly(['call', 'lastMessage', 'lastMessageAt'])
            && (!changes().hasAny(['call']) || request.resource.data.call == null
                || request.resource.data.call.from == request.auth.uid))
        );
        allow delete: if request.auth != null && request.auth.uid in resource.data.users;

        match /messages/{msgId} {
          function friendship() {
            return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/friendships/$(pairId)).data;
          }
          allow read: if request.auth != null && request.auth.uid in friendship().users
            && friendship().status == 'accepted';
          allow create: if request.auth != null && request.auth.uid in friendship().users
            && friendship().status == 'accepted'
            && request.resource.data.keys().hasOnly(['from', 'text', 'ts'])
            && request.resource.data.from == request.auth.uid
            && request.resource.data.text is string && request.resource.data.text.size() <= 1000
            && recentTs(request.resource.data.ts);
        }
      }

      // ---------------- Reports ----------------
      // Write-only for clients; moderators read them in the console / Admin SDK.
      // You can only report someone you were actually in a room with.
      match /reports/{reportId} {
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['reporter', 'reported', 'roomId', 'reason', 'ts'])
          && request.resource.data.reporter == request.auth.uid
          && request.resource.data.reason in ['sexual', 'minor', 'harassment', 'spam', 'other', 'auto-nudity']
          && request.resource.data.roomId is string
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(request.resource.data.roomId)).data.users.hasAll([request.auth.uid, request.resource.data.reported]);
      }
    }
  }
}
