rules_version = '2';

// Security rules for Anonymous Connect.
// Firestore only holds short-lived matchmaking + WebRTC signaling data and abuse reports.
// Chat messages never touch the database (they go peer-to-peer over a data channel).
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/public/data {

      // One waiting-queue entry per user, keyed by their auth uid.
      match /queue/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        // Owner may refresh their heartbeat; anyone signed in may claim an unclaimed entry
        // by setting roomId + partnerId (= their own uid) exactly once.
        allow update: if request.auth != null && (
          (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ts'])) ||
          (resource.data.roomId == null
            && request.resource.data.partnerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roomId', 'partnerId']))
        );
      }

      match /rooms/{roomId} {
        allow create: if request.auth != null
          && request.auth.uid in request.resource.data.users
          && request.resource.data.users.size() == 2;
        allow read: if request.auth != null && request.auth.uid in resource.data.users;

        // Signaling messages: only the two room members can read/write, and only as themselves.
        match /signals/{signalId} {
          function isMember() {
            return request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(roomId)).data.users;
          }
          allow read: if request.auth != null && isMember();
          allow create: if request.auth != null && isMember()
            && request.resource.data.from == request.auth.uid;
          allow delete: if request.auth != null && resource.data.from == request.auth.uid;
        }
      }

      // Presence heartbeat for the "people online" count. Each user writes only their own doc.
      match /presence/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ts', 'status'])
          && request.resource.data.ts is int;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // Friendships: doc id is "<uidA>_<uidB>" (sorted). Created "pending" by the requester,
      // accepted by the other person. Only Google-signed-in users can befriend.
      match /friendships/{pairId} {
        function signedIn() {
          return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
        }
        function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }

        allow read: if request.auth != null && request.auth.uid in resource.data.users;
        allow create: if signedIn()
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.users.size() == 2
          && request.auth.uid in request.resource.data.users
          && pairId == request.resource.data.users[0] + '_' + request.resource.data.users[1];
        allow update: if signedIn() && request.auth.uid in resource.data.users && (
          // the other person accepts
          (resource.data.status == 'pending' && request.auth.uid != resource.data.requestedBy
            && request.resource.data.status == 'accepted'
            && changes().hasOnly(['status', 'names', 'acceptedAt']))
          // the requester re-sends their own pending request
          || (resource.data.status == 'pending' && request.auth.uid == resource.data.requestedBy
            && request.resource.data.status == 'pending'
            && request.resource.data.users == resource.data.users
            && request.resource.data.requestedBy == resource.data.requestedBy)
          // friends: ring / cancel a call, update the chat preview
          || (resource.data.status == 'accepted'
            && changes().hasOnly(['call', 'lastMessage', 'lastMessageAt'])
            && (request.resource.data.get('call', null) == null || request.resource.data.call.from == request.auth.uid
                || !changes().hasAny(['call'])))
        );
        allow delete: if request.auth != null && request.auth.uid in resource.data.users;

        match /messages/{msgId} {
          function friendship() {
            return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/friendships/$(pairId)).data;
          }
          allow read: if request.auth != null && request.auth.uid in friendship().users
            && friendship().status == 'accepted';
          allow create: if request.auth != null && request.auth.uid in friendship().users
            && friendship().status == 'accepted'
            && request.resource.data.from == request.auth.uid
            && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
        }
      }

      // Reports are write-only for clients; moderators read them via the console / Admin SDK.
      match /reports/{reportId} {
        allow create: if request.auth != null
          && request.resource.data.reporter == request.auth.uid
          && request.resource.data.reason in ['sexual', 'minor', 'harassment', 'spam', 'other', 'auto-nudity'];
      }
    }
  }
}
