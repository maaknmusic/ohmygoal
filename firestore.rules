rules_version = '2';

// Security rules for OhMyGoal.
// Random-chat messages never touch the database (they go peer-to-peer over a data channel).
// Firestore holds short-lived matchmaking + WebRTC signaling data, presence, reports,
// friendships (+ friend messages) and Premium entitlements (written only by Cloud Functions).
service cloud.firestore {
  match /databases/{database}/documents {
    // Pinned to the real app id (config.js APP_ID / functions .env APP_ID): no other path under artifacts/ is writable.
    match /artifacts/anon-connect/public/data {

      function now() { return request.time.toMillis(); }
      function recentTs(ts) { return ts is int && ts <= now() + 300000 && ts >= now() - 600000; }
      function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function google() {
        return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
      }

      // ---------------- Premium ----------------
      // Passes are granted ONLY by the payment Cloud Functions (the Admin SDK bypasses rules).
      function isPremium(uid) {
        let path = /databases/$(database)/documents/artifacts/anon-connect/public/data/entitlements/$(uid);
        return exists(path) && get(path).data.premiumUntil > now();
      }

      // ---------------- Access passes ----------------
      // Written only by the checkAccess Cloud Function after checking IP / device / account bans.
      function hasAccess(uid, mode) {
        let path = /databases/$(database)/documents/artifacts/anon-connect/public/data/access/$(uid);
        return exists(path) && get(path).data.until > now()
          && (mode != 'video' || get(path).data.get('videoBanUntil', 0) < now());
      }

      match /access/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow list, write: if false;
      }

      // Only the owner can read their own pass. A chat partner's badge is checked by the partnerPremium
      // Cloud Function, which answers yes/no and only for someone you share a room with.
      match /entitlements/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow list, write: if false;
      }

      // ---------------- Reputation ("good vibe" likes) ----------------
      // Written only by the likeUser Cloud Function. Readable one uid at a time (a partner's like
      // count), never listable, so nobody can enumerate or rank users.
      match /reputation/{uid} {
        allow get: if request.auth != null;
        allow list, write: if false;
      }

      // ---------------- Profiles (native language, nick, avatar, interests, gender) ----------------
      // Only for people signed in with Google: their profile follows them across devices. Anonymous accounts keep the
      // same details in their own browser and never write here. Read and written only by the owner, never listable.
      // The language list must stay in step with functions/languages.js and js/languages.js.
      function validLang(l) {
        return l is string && l in ['en', 'hi', 'bn', 'ta', 'te', 'mr', 'gu', 'kn', 'ml', 'pa', 'ur', 'or', 'as', 'ne', 'es', 'fr', 'de', 'pt',
                                    'it', 'nl', 'ru', 'uk', 'pl', 'tr', 'ar', 'fa', 'he', 'id', 'ms', 'th', 'vi', 'zh', 'zh-TW', 'ja',
                                    'ko', 'sw', 'fil', 'el', 'cs', 'sv', 'ro', 'hu', 'da', 'fi', 'nb'];
      }
      // Rules can't loop over a list, so each of the (at most five) interests is checked by position.
      function validInterestAt(items, i) { return items.size() <= i || (items[i] is string && items[i].size() <= 24); }
      function validProfile(d) {
        return d.keys().hasOnly(['lang', 'nick', 'avatar', 'interests', 'gender', 'updatedAt'])
          && validLang(d.get('lang', 'en'))
          && d.get('nick', 'x') is string && d.get('nick', 'x').size() >= 1 && d.get('nick', 'x').size() <= 20
          && (!('avatar' in d.keys())
              || (d.avatar is map && d.avatar.keys().hasOnly(['e', 'h'])
                  && d.avatar.e is string && d.avatar.e.size() >= 1 && d.avatar.e.size() <= 8
                  && d.avatar.h is int && d.avatar.h >= 0 && d.avatar.h <= 359))
          && d.get('interests', []) is list && d.get('interests', []).size() <= 5
          && validInterestAt(d.get('interests', []), 0) && validInterestAt(d.get('interests', []), 1)
          && validInterestAt(d.get('interests', []), 2) && validInterestAt(d.get('interests', []), 3)
          && validInterestAt(d.get('interests', []), 4)
          && d.get('gender', '') is string && d.get('gender', '') in ['male', 'female', 'x', '']
          && d.updatedAt is int;
      }
      match /profiles/{uid} {
        allow get: if google() && request.auth.uid == uid;
        allow list: if false;
        allow create, update: if google() && request.auth.uid == uid && validProfile(request.resource.data);
        allow delete: if google() && request.auth.uid == uid;
      }

      // ---------------- Matchmaking queue ----------------
      function validQueue(d) {
        return d.keys().hasOnly(['mode', 'interests', 'blocked', 'gender', 'country', 'genderFilter',
                                 'countryFilter', 'premium', 'theme', 'lang', 'learn', 'ts', 'roomId'])
          && d.mode in ['video', 'voice', 'text']
          && d.get('interests', []) is list && d.get('interests', []).size() <= 5
          && d.get('interests', []).join(',').size() <= 140
          && d.get('blocked', []) is list && d.get('blocked', []).size() <= 100
          && d.get('blocked', []).join(',').size() <= 4000
          && d.get('gender', 'x') in ['male', 'female', 'x']
          && d.get('country', '') is string && d.get('country', '').size() <= 2
          && d.get('genderFilter', 'any') in ['any', 'male', 'female']
          && d.get('countryFilter', 'any') is string && d.get('countryFilter', 'any').size() <= 3
          && d.get('premium', false) is bool
          && d.get('theme', '') in ['', 'study', 'cricket', 'music', 'latenight', 'gaming', 'chill', 'langx']
          && d.get('lang', '') is string && d.get('lang', '').size() <= 8
          && d.get('learn', '') is string && d.get('learn', '').size() <= 8
          && d.get('roomId', null) == null
          && recentTs(d.ts);
      }
      // Gender/country filters and priority matching are Premium features.
      function usesPremium(d) {
        return d.get('genderFilter', 'any') != 'any' || d.get('countryFilter', 'any') != 'any'
          || d.get('premium', false) == true;
      }
      // A claimer must be queued themselves, in the same mode, not blocked either way,
      // and must satisfy the target's filters.
      function claimAllowed(uid) {
        let mine = get(/databases/$(database)/documents/artifacts/anon-connect/public/data/queue/$(request.auth.uid)).data;
        let theirs = resource.data;
        return mine.mode == theirs.mode
          && mine.get('theme', '') == theirs.get('theme', '')
          && !(request.auth.uid in theirs.get('blocked', []))
          && !(uid in mine.get('blocked', []))
          && theirs.get('genderFilter', 'any') in ['any', mine.get('gender', 'x')]
          && theirs.get('countryFilter', 'any') in ['any', mine.get('country', '')];
      }

      match /queue/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid
          && validQueue(request.resource.data)
          && hasAccess(uid, request.resource.data.mode)
          && (!usesPremium(request.resource.data) || isPremium(uid));
        // The owner removes their entry; anyone may clear one nobody has refreshed for 3 minutes (left-over from a closed tab).
        allow delete: if request.auth != null && (request.auth.uid == uid
          || (resource.data.get('ts', 0) is int && resource.data.get('ts', 0) < now() - 180000));
        allow update: if request.auth != null && (
          // owner heartbeat
          (request.auth.uid == uid && changes().hasOnly(['ts']) && recentTs(request.resource.data.ts))
          // owner re-queues over a stale entry
          || (request.auth.uid == uid && validQueue(request.resource.data)
              && hasAccess(uid, request.resource.data.mode)
              && (!usesPremium(request.resource.data) || isPremium(uid)))
          // someone else claims an unclaimed entry, creating a real room for the two of them
          || (request.auth.uid != uid
              && resource.data.get('roomId', null) == null
              && resource.data.ts is int && resource.data.ts >= now() - 60000
              && changes().hasOnly(['roomId', 'partnerId'])
              && request.resource.data.partnerId == request.auth.uid
              && request.resource.data.roomId is string
              && claimAllowed(uid)
              && getAfter(/databases/$(database)/documents/artifacts/anon-connect/public/data/rooms/$(request.resource.data.roomId)).data.users.hasAll([uid, request.auth.uid]))
        );
      }

      // ---------------- Rooms & signaling ----------------
      // A room is either a matchmaking room (created in the same batch that claims a queued person, stamped
      // with server time) or a friend call (between two accepted friends). Nobody can invent a room with
      // an arbitrary victim or a back-dated timestamp, which keeps likes and reports tied to real matches.
      function matchRoom(roomId, d) {
        let other = d.users[0] == request.auth.uid ? d.users[1] : d.users[0];
        let qp = /databases/$(database)/documents/artifacts/anon-connect/public/data/queue/$(other);
        return !('friendship' in d.keys())
          && d.created == request.time
          && exists(qp)
          && get(qp).data.get('roomId', null) == null
          && get(qp).data.get('ts', 0) is int && get(qp).data.get('ts', 0) >= now() - 60000
          && get(qp).data.mode == d.mode
          && getAfter(qp).data.get('roomId', null) == roomId
          && getAfter(qp).data.get('partnerId', null) == request.auth.uid;
      }
      function friendRoom(d) {
        let fp = /databases/$(database)/documents/artifacts/anon-connect/public/data/friendships/$(d.friendship);
        return d.get('friendship', null) is string
          && d.created is number
          && d.mode == 'video'
          && exists(fp)
          && get(fp).data.status == 'accepted'
          && get(fp).data.users.hasAll(d.users);
      }
      match /rooms/{roomId} {
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['mode', 'users', 'created', 'friendship'])
          && request.resource.data.mode in ['video', 'voice', 'text']
          && request.resource.data.users is list
          && request.resource.data.users.size() == 2
          && request.resource.data.users[0] != request.resource.data.users[1]
          && request.auth.uid in request.resource.data.users
          && hasAccess(request.auth.uid, request.resource.data.mode)
          && ('friendship' in request.resource.data.keys()
              ? friendRoom(request.resource.data)
              : matchRoom(roomId, request.resource.data));
        allow read: if request.auth != null && request.auth.uid in resource.data.users;

        // Signaling messages: only the two room members can read/write, and only as themselves.
        match /signals/{signalId} {
          function isMember() {
            return request.auth.uid in get(/databases/$(database)/documents/artifacts/anon-connect/public/data/rooms/$(roomId)).data.users;
          }
          allow read: if request.auth != null && isMember();
          // Only the four WebRTC message kinds, with bounded fields, so a room can't be used as free storage.
          function validSignal(d) {
            return d.keys().hasOnly(['from', 'type', 'data', 'ts'])
              && d.type in ['offer', 'answer', 'candidate', 'bye']
              && d.ts is number
              && (d.get('data', null) == null
                  || (d.data is map
                      && d.data.keys().hasOnly(['type', 'sdp', 'candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment'])
                      && d.data.get('sdp', '') is string && d.data.get('sdp', '').size() <= 20000
                      && d.data.get('candidate', '') is string && d.data.get('candidate', '').size() <= 2000
                      && d.data.get('type', '') is string && d.data.get('type', '').size() <= 16
                      && (d.data.get('sdpMid', null) == null || (d.data.sdpMid is string && d.data.sdpMid.size() <= 64))
                      && (d.data.get('usernameFragment', null) == null || (d.data.usernameFragment is string && d.data.usernameFragment.size() <= 64))
                      && (d.data.get('sdpMLineIndex', null) == null || d.data.sdpMLineIndex is number)));
          }
          allow create: if request.auth != null && isMember()
            && request.resource.data.from == request.auth.uid
            && validSignal(request.resource.data);
          allow delete: if request.auth != null && resource.data.from == request.auth.uid;
        }
      }

      // ---------------- Presence ("people online") ----------------
      match /presence/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ts', 'status'])
          && request.resource.data.get('status', 'online') in ['online', 'away']
          && recentTs(request.resource.data.ts);
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // ---------------- Friends ----------------
      // Doc id is "<uidA>_<uidB>" (sorted). Created "pending" by the requester, accepted by the
      // other person. Only Google-signed-in users can befriend.
      function validName(d, u) { return d.names.get(u, '') is string && d.names.get(u, '').size() <= 30; }
      function validCall(c) {
        return c == null || (c is map && c.keys().hasOnly(['from', 'roomId', 'ts'])
          && c.from is string && c.from.size() <= 128 && c.roomId is string && c.roomId.size() <= 40 && c.ts is int);
      }
      function validFriendship(d, pairId) {
        return d.keys().hasOnly(['users', 'status', 'requestedBy', 'names', 'createdAt', 'acceptedAt',
                                 'call', 'lastMessage', 'lastMessageAt'])
          && d.users is list && d.users.size() == 2 && d.users[0] is string && d.users[1] is string
          && pairId == d.users[0] + '_' + d.users[1]
          && d.status in ['pending', 'accepted']
          && d.requestedBy in d.users
          && d.names is map && d.names.keys().hasOnly(d.users)
          && validName(d, d.users[0]) && validName(d, d.users[1])
          && validCall(d.get('call', null))
          && d.get('lastMessage', '') is string && d.get('lastMessage', '').size() <= 80
          && d.get('lastMessageAt', 0) is int
          && d.get('createdAt', 0) is int && d.get('acceptedAt', 0) is int
          && d.users[0].size() <= 128 && d.users[1].size() <= 128;
      }

      match /friendships/{pairId} {
        allow read: if request.auth != null && request.auth.uid in resource.data.users;
        allow create: if google()
          && validFriendship(request.resource.data, pairId)
          && request.auth.uid in request.resource.data.users
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if google() && request.auth.uid in resource.data.users
          && validFriendship(request.resource.data, pairId)
          && request.resource.data.users == resource.data.users && (
          // either person (re-)sends a request while it is still pending
          (resource.data.status == 'pending' && request.resource.data.status == 'pending'
            && request.resource.data.requestedBy == request.auth.uid)
          // the other person accepts, setting only their own name
          || (resource.data.status == 'pending' && request.auth.uid != resource.data.requestedBy
            && request.resource.data.status == 'accepted'
            && changes().hasOnly(['status', 'names', 'acceptedAt'])
            && request.resource.data.names.get(resource.data.requestedBy, '') == resource.data.names.get(resource.data.requestedBy, ''))
          // friends: ring / cancel a call (only as yourself), update the chat preview
          || (resource.data.status == 'accepted' && request.resource.data.status == 'accepted'
            && changes().hasOnly(['call', 'lastMessage', 'lastMessageAt'])
            && (!changes().hasAny(['call']) || request.resource.data.call == null
                || request.resource.data.call.from == request.auth.uid))
        );
        allow delete: if request.auth != null && request.auth.uid in resource.data.users;

        match /messages/{msgId} {
          function friendship() {
            return get(/databases/$(database)/documents/artifacts/anon-connect/public/data/friendships/$(pairId)).data;
          }
          allow read: if request.auth != null && request.auth.uid in friendship().users
            && friendship().status == 'accepted';
          allow create: if request.auth != null && request.auth.uid in friendship().users
            && friendship().status == 'accepted'
            && request.resource.data.keys().hasOnly(['from', 'text', 'ts'])
            && request.resource.data.from == request.auth.uid
            && request.resource.data.text is string && request.resource.data.text.size() <= 1000
            && recentTs(request.resource.data.ts);
          allow delete: if request.auth != null && request.auth.uid in friendship().users;
        }
      }

      // ---------------- Group rooms ----------------
      // Rooms and their members are created by the joinGroup function (so the size limit is real). A member keeps their own `ts`
      // fresh and deletes their own document to leave. Handshake messages go from a member to a member of the same room.
      match /groups/{gid} {
        allow read: if request.auth != null;
        allow write: if false;
        match /members/{uid} {
          allow read: if request.auth != null;
          allow create: if false;
          allow update: if request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ts'])
            && recentTs(request.resource.data.ts);
          allow delete: if request.auth != null && request.auth.uid == uid;
        }
        // gifts sent to a live host (written by the sendLiveGift function only), shown to the room as a small animation
        match /events/{eventId} {
          allow read: if request.auth != null;
          allow write: if false;
        }
        match /signals/{signalId} {
          function inRoom(u) {
            return exists(/databases/$(database)/documents/artifacts/anon-connect/public/data/groups/$(gid)/members/$(u));
          }
          allow read: if request.auth != null && resource.data.to == request.auth.uid;
          allow create: if request.auth != null && inRoom(request.auth.uid)
            && request.resource.data.keys().hasOnly(['from', 'to', 'type', 'data', 'ts'])
            && request.resource.data.from == request.auth.uid
            && request.resource.data.to is string && request.resource.data.to.size() <= 128
            && inRoom(request.resource.data.to)
            && request.resource.data.type in ['offer', 'answer', 'candidate', 'bye']
            && request.resource.data.ts is number
            && (request.resource.data.get('data', null) == null
                || (request.resource.data.data is map
                    && request.resource.data.data.keys().hasOnly(['type', 'sdp', 'candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment'])
                    && request.resource.data.data.get('sdp', '') is string && request.resource.data.data.get('sdp', '').size() <= 20000
                    && request.resource.data.data.get('candidate', '') is string && request.resource.data.data.get('candidate', '').size() <= 2000));
          allow delete: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
        }
      }

      // ---------------- Reports ----------------
      // Write-only for clients; moderators read them in the console / Admin SDK.
      // You can only report someone you were actually in a room with.
      // The document id is reporter_room_reason, so one person can't flood the moderators with copies.
      match /reports/{reportId} {
        allow create: if request.auth != null
          && reportId == request.auth.uid + '_' + request.resource.data.roomId + '_' + request.resource.data.reason
          && request.resource.data.keys().hasOnly(['reporter', 'reported', 'roomId', 'reason', 'evidence', 'ts'])
          && (!('evidence' in request.resource.data) || (request.resource.data.evidence is string && request.resource.data.evidence.size() <= 300))
          && request.resource.data.reporter == request.auth.uid
          && request.resource.data.ts == request.time
          && request.resource.data.reason in ['sexual', 'minor', 'harassment', 'spam', 'other', 'auto-nudity']
          && request.resource.data.roomId is string
          && (exists(/databases/$(database)/documents/artifacts/anon-connect/public/data/rooms/$(request.resource.data.roomId))
              ? get(/databases/$(database)/documents/artifacts/anon-connect/public/data/rooms/$(request.resource.data.roomId)).data.users.hasAll([request.auth.uid, request.resource.data.reported])
              : (exists(/databases/$(database)/documents/artifacts/anon-connect/public/data/groups/$(request.resource.data.roomId)/members/$(request.auth.uid))
                 && exists(/databases/$(database)/documents/artifacts/anon-connect/public/data/groups/$(request.resource.data.roomId)/members/$(request.resource.data.reported))));
      }
    }
  }
}
