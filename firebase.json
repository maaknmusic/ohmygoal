{
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json", ".firebaserc", ".git", ".github", "**/.*", "**/node_modules/**",
            "functions/**", "firestore.rules", "deploy.sh", "*.md", "_preview/**", "parts/**"
        ],
        "cleanUrls": false,
        "headers": [
            {
                "source": "**",
                "headers": [
                    { "key": "X-Content-Type-Options", "value": "nosniff" },
                    { "key": "X-Frame-Options", "value": "DENY" },
                    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                    { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), interest-cohort=()" },
                    { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
                ]
            },
            {
                "source": "**/*.@(html|js|css|webmanifest)",
                "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
            },
            {
                "source": "models/**",
                "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
            },
            {
                "source": "/sw.js",
                "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
            }
        ]
    },
    "firestore": {
        "rules": "firestore.rules"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "runtime": "nodejs22",
            "ignore": ["node_modules", ".git", "*.local", "firebase-debug.log"]
        }
    ]
}
