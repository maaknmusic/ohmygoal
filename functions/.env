# Non-secret settings for the payment functions. Secrets (Razorpay keys) are stored in
# Google Secret Manager: see README "Premium payments".
APP_ID=anon-connect
# Razorpay API address (only changed in local tests)
RAZORPAY_API=https://api.razorpay.com
# Cloudflare TURN API address (only changed in local tests)
CF_TURN_API=https://rtc.live.cloudflare.com
# Live translate (functions/translate.js): Gemini on Vertex AI. These are the defaults. (The deploy needs every parameter to have a value here when it is not run interactively.)
# The Vertex AI API must be enabled once: gcloud services enable aiplatform.googleapis.com --project ohmygoal-c8a4a
TRANSLATE_MODEL=gemini-2.5-flash-lite
TRANSLATE_LOCATION=global
TRANSLATE_API=https://aiplatform.googleapis.com
# Friend notifications (functions/push.js): 'live' sends them; only the emulator tests use 'outbox'.
PUSH_MODE=live
# Firebase App Check for the callable functions (see README "Bots and App Check"). 'false': check the token and count it in the Firebase console, but turn nobody away.
# Set to 'true' (and deploy again) only after the console shows nearly all requests as verified.
ENFORCE_APP_CHECK=false
